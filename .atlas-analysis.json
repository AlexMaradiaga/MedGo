    "GET /api/especialidades",
    "POST /api/citas",
    "GET /api/citas/historial/{usuarioId}",
    "PUT /api/citas/{id}/reprogramar",
    "DELETE /api/citas/{id}",
    "GET /api/pacientes/usuario/{id}",
    "POST /api/pacientes/{id}/emancipar",
    "GET /api/historial/consultas/{usuarioId}",
    "GET /api/historial/recetas/{usuarioId}",
    "GET /api/historial/examenes/{usuarioId}",
    "GET /api/recetas/pdf/{recetaId}",
    "GET /api/laboratorio/catalogo",
    "GET /api/laboratorio/paciente/{pacienteId}/ordenes",
    "GET /api/laboratorio/orden/{ordenId}/resultados",
    "POST /api/doctor/consulta/finalizar",
    "GET /api/doctor/paciente/{pacienteId}/historial-completo",
    "POST /api/doctor/cita/aprobar/{id}",
    "POST /api/doctor/cita/rechazar/{id}",
    "GET /api/doctor/diagnosticos/buscar",
    "POST /api/pagos/procesar",
    "GET /api/reports/dashboard",
