  "keyFeatures": [
    "Registro y verificación de médicos con credenciales digitales",
    "Gestión de citas con aprobación, rechazo y reprogramación",
    "Historia clínica completa: signos vitales, examen físico por sistemas, diagnóstico CIE-11",
    "Generación y descarga de recetas en PDF con código QR de canje",
    "Módulo de odontología con odontograma interactivo",
    "Órdenes y resultados de laboratorio",
    "Autorización cruzada de médicos para acceso al historial del paciente",
    "Gestión de dependientes y tutores",
    "Dashboards analíticos con gráficas para admin, clínica y laboratorio",
    "Planes SaaS con control de límites por suscripción",
    "Exportación de reportes ejecutivos en PDF",
    "Soporte multilenguaje (español e inglés)"
  ],
  "publicApiSurface": [
    "POST /api/login",
    "POST /api/logout",
    "PUT /api/auth/password",
    "POST /api/register-patient",
    "POST /api/register-doctor",
    "GET /api/doctores",
